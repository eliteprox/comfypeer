# PymtHouse staging (OIDC issuer + M2M for Builder API)
PYMTHOUSE_ISSUER_URL=https://staging.pymthouse.com/api/v1/oidc
PYMTHOUSE_PUBLIC_CLIENT_ID=
PYMTHOUSE_M2M_CLIENT_ID=
PYMTHOUSE_M2M_CLIENT_SECRET=
# PYMTHOUSE_ALLOW_INSECURE_HTTP=0
# Remote signer DMZ when exchange/routing omit signer_url (also accepts SIGNER_URL).
# Must match the issuer environment (staging token → staging DMZ). Do not point
# staging mint at production https://signer.pymthouse.com or payment returns 401.
# PYMTHOUSE_SIGNER_URL=

# Auth0
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# Session signing (generate: openssl rand -base64 32)
COMFYPEER_SESSION_SECRET=

# Staging Livepeer orchestrators (ComfyStream / live-runner :8936)
# Prefer ORCH_URL for primary; ORCH_URLS is a comma-separated fallback list.
# Live runners are listed via GET {ORCH}/discovery (not classic AI capabilities).
ORCH_URL=https://liverunner-staging-1.daydream.monster:8936
ORCH_URLS=https://liverunner-staging-1.daydream.monster:8936,https://liverunner-2.daydream.monster:8936,https://liverunner-3.daydream.monster:8936
# Example local live-runner orch (optional):
# ORCH_URL=https://ai1.eliteencoder.net:8936
# ORCH_URLS=https://ai1.eliteencoder.net:8936

# Canonical public origin (scheme + host, no path). Required for CSRF origin
# checks on session provisioning — requests fail closed if this is missing
# or not a valid URL. Also used for Auth0 callbacks, Stripe return URLs, CORS.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Extra browser origins allowed to call credentialed APIs (comma-separated),
# e.g. the standalone comfystream UI.
# COMFYPEER_CORS_ORIGINS=http://localhost:3001

# Prefer SignerSession discovery_url; pin orch discovery when needed.
# Studio streams video over orch-proxied wss://…/ws_stream (no host WebRTC bridge).
NEXT_PUBLIC_ORCH_DISCOVERY_URL=https://ai1.eliteencoder.net:8936/discovery

# MCP (beat two — after pymthouse #382)
NEXT_PUBLIC_PYMTHOUSE_MCP_URL=https://staging.pymthouse.com/api/v1/mcp
