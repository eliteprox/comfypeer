# PymtHouse staging (OIDC issuer + M2M for Builder API)
PYMTHOUSE_ISSUER_URL=https://staging.pymthouse.com/api/v1/oidc
PYMTHOUSE_PUBLIC_CLIENT_ID=
PYMTHOUSE_M2M_CLIENT_ID=
PYMTHOUSE_M2M_CLIENT_SECRET=
# PYMTHOUSE_ALLOW_INSECURE_HTTP=0

# Session signing (generate: openssl rand -base64 32)
COMFYPEER_SESSION_SECRET=

# Staging Livepeer orchestrators (ComfyStream / live-runner :8936)
# Prefer ORCH_URL for primary; ORCH_URLS is a comma-separated fallback list.
ORCH_URL=https://liverunner-staging-1.daydream.monster:8936
ORCH_URLS=https://liverunner-staging-1.daydream.monster:8936,https://liverunner-2.daydream.monster:8936,https://liverunner-3.daydream.monster:8936

# Public site URL (Stripe return URLs, CORS docs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MCP (beat two — after pymthouse #382)
NEXT_PUBLIC_PYMTHOUSE_MCP_URL=https://staging.pymthouse.com/api/v1/mcp
